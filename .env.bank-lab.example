# Copy to .env.bank-lab with permissions 600. Never commit real values.
# Generate two DIFFERENT values locally with: openssl rand -hex 32
BANK_DB_PASSWORD=replace_with_64_hex_characters
BANK_APP_DB_PASSWORD=replace_with_different_64_hex_characters
BANK_TRAINING_DB_PASSWORD=replace_with_another_different_64_hex_characters
# Set to sqli-training only for the isolated SQL injection training scenario.
BANK_SCENARIO=baseline
# Choose two DIFFERENT passwords of at least 16 characters. Usernames: customer, vault.
BANK_CUSTOMER_PASSWORD=replace_with_customer_password
BANK_VAULT_PASSWORD=replace_with_vault_password

# Availability training stays disabled in baseline. Read docs/BANK_AVAILABILITY_HANDOFF.md.
# Set BANK_SCENARIO=availability-training only after approving the exact isolated run.
# Obtain the actual run/version through trusted bootstrap, then calibrate every profile field.
# Generate three DIFFERENT private 64-hex capability tokens. Never show them to agents.
BANK_AVAILABILITY_APPROVAL_ID=
BANK_AVAILABILITY_RUN_ID=
BANK_AVAILABILITY_VERSION=
BANK_AVAILABILITY_MAX_REQUESTS=
BANK_AVAILABILITY_MAX_CONCURRENT=
BANK_AVAILABILITY_DURATION_MS=
BANK_AVAILABILITY_WORK_MS=
BANK_AVAILABILITY_DEGRADED_AT=
BANK_AVAILABILITY_MITIGATION_TTL_MS=
BANK_AVAILABILITY_LOAD_TOKEN=
BANK_AVAILABILITY_PROBE_TOKEN=
BANK_AVAILABILITY_EXECUTOR_TOKEN=
